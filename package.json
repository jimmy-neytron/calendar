{
  "name": "skylight-calendar-clone-vue3-ru",
  "version": "1.9.0",
  "private": true,
  "type": "module",
  "description": "Семейный workspace-календарь на Vue 3 с Supabase Auth, RLS и синхронизацией данных.",
  "scripts": {

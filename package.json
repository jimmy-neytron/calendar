    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.108.2",
    "@tanstack/vue-query": "5.101.2",
    "@tiptap/core": "3.27.1",
    "@tiptap/extension-link": "3.27.1",
    "@tiptap/extension-placeholder": "3.27.1",
    "@tiptap/pm": "3.27.1",
    "@tiptap/starter-kit": "3.27.1",
    "@tiptap/vue-3": "3.27.1",
    "@vitejs/plugin-vue": "6.0.7",
    "chart.js": "4.5.1",
    "cytoscape": "3.34.0",
    "vite": "8.0.16",
    "vue": "3.5.38",
    "vue-chartjs": "5.3.3",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "jsdom": "29.1.1",
    "vitest": "4.1.9"
